---
// src/components/Analytics.astro
// ============================================================================
// Seguimiento de comportamiento. Stack recomendado y gratuito:
//   1. Google Analytics 4  -> tráfico, adquisición, conversiones, embudos.
//   2. Microsoft Clarity   -> mapas de calor + grabaciones de sesión +
//                             scroll/click/rage-clicks. 100% gratis e ilimitado.
//
// Ambos se activan SOLO si la variable de entorno correspondiente existe,
// así que el sitio nunca se rompe si aún no has pegado tus IDs.
//
// Configúralos en tu archivo .env (y en los secretos del deploy):
//   PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"
//   PUBLIC_CLARITY_PROJECT_ID="xxxxxxxxxx"
// ============================================================================
const GA_ID = import.meta.env.PUBLIC_GA_MEASUREMENT_ID;
const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_PROJECT_ID;
---

{/* ─── Google Analytics 4 ─────────────────────────────────────────── */}
{
  GA_ID && (
    <>
      <script
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
      />
      <script set:html={`
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        window.gtag = gtag;
        gtag('js', new Date());
        gtag('config', '${GA_ID}', { send_page_view: true, anonymize_ip: true });
        window.__gaId = '${GA_ID}';
      `} />
      {/* Reenvía page_view en cada navegación SPA (View Transitions) */}
      <script set:html={`
        document.addEventListener('astro:page-load', function () {
          if (typeof window.gtag === 'function' && window.__gaId) {
            window.gtag('event', 'page_view', {
              page_title: document.title,
              page_location: window.location.href,
              page_path: window.location.pathname,
            });
          }
        });
      `} />
    </>
  )
}

{/* ─── Microsoft Clarity (heatmaps + session recordings) ──────────── */}
{
  CLARITY_ID && (
    <script set:html={`
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "${CLARITY_ID}");
    `} />
  )
}
