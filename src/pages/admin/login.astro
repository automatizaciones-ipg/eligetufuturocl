---
// src/pages/admin/login.astro
import Layout from "../../layouts/Layout.astro";

const error = Astro.url.searchParams.get("error") === "1";
---

<Layout title="Acceso admin" noindex={true}>
  <main class="min-h-[70vh] flex items-center justify-center px-4">
    <form
      method="POST"
      action="/api/admin/login"
      class="w-full max-w-sm rounded-2xl border border-base-300 bg-base-200/40 p-6"
    >
      <h1 class="text-lg font-bold mb-4">Panel admin</h1>

      {error && (
        <p class="text-sm text-error mb-3">Contraseña incorrecta.</p>
      )}

      <label class="block text-sm font-medium mb-1" for="password">Contraseña</label>
      <input
        type="password"
        id="password"
        name="password"
        required
        autofocus
        class="w-full rounded-lg border border-base-300 bg-base-100 px-3 py-2 mb-4 outline-none focus:ring-2 focus:ring-primary"
      />

      <button type="submit" class="btn btn-primary w-full">Entrar</button>
    </form>
  </main>
</Layout>
