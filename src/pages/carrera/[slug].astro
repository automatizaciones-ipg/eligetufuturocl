---
// src/pages/carrera/[slug].astro
import type { GetStaticPaths } from "astro";
import CarreraDetalle from "../../components/CarreraDetalle";
import Layout from "../../layouts/Layout.astro";
import { courseSchema, breadcrumbSchema } from "../../lib/seo";
import {
  formatearTitulo,
  describirLugar,
  describirJornada,
  recortarDescripcion,
  slugificar,
} from "../../utils/formatters";
import { enlaceCarrera, enlaceInstitucion } from "../../utils/enlaces";
import { regionPorValor } from "../../utils/regiones";
import {
  variantesDelPrograma,
  carreraCompletaPorSlug,
  slugsDeFichasCarrera,
} from "../../services/carrerasIndex";

export const prerender = true;

// Una ruta por ficha publicable (programa+institución+sede+jornada distinto).
// Los códigos duplicados por basura de ingesta SIES (`canonico`, ver
// carrerasIndex.ts) ya no generan página propia — antes competían con
// metadatos idénticos y un <link rel="canonical"> hacia otra URL.
export const getStaticPaths = (async () => {
  const slugs = await slugsDeFichasCarrera();
  return slugs.map((slug) => ({ params: { slug } }));
}) satisfies GetStaticPaths;

const { slug } = Astro.params;

// La ficha se resuelve desde el índice en memoria, no con una consulta por
// página: son ~9.600 páginas prerenderizadas y esa consulta individual costaba
// ~330 ms cada una, casi una hora de build en cada despliegue.
const carrera = await carreraCompletaPorSlug(slug!);

if (!carrera) {
  return Astro.redirect("/404");
}

// ============================================================================
// METADATOS DIFERENCIADOS
// ----------------------------------------------------------------------------
// El mismo programa se dicta hasta en 25 sedes y 4 jornadas, pero antes todas
// esas fichas compartían <title>, descripción y H1 (solo "carrera - institución"):
// 7.812 de las ~9.900 URLs eran duplicados a ojos de Google. Añadir sede y
// jornada las vuelve páginas distintas y, de paso, captura la búsqueda local
// ("técnico en enfermería puerto montt vespertino").
// ============================================================================
const institucionNombre =
  carrera.instituciones?.nombre ?? "institución de educación superior";
const nombreCarrera = formatearTitulo(carrera.nombre_carrera);
const lugar = describirLugar(carrera.sede, carrera.region);
const jornada = describirJornada(carrera.jornada);

const title = [
  nombreCarrera,
  lugar ? ` en ${lugar}` : "",
  jornada ? ` (${jornada})` : "",
  ` - ${institucionNombre}`,
].join("");

// La descripción se compone con los datos reales de ESTA fila. Antes se usaba
// `carrera.descripcion`, que es texto de plantilla: solo 1.440 variantes para
// 9.901 fichas (una misma llegaba a repetirse en 360 páginas).
const datos = [
  jornada ? `jornada ${jornada.toLowerCase()}` : null,
  carrera.duracion_semestres ? `${carrera.duracion_semestres} semestres` : null,
  carrera.arancel_anual
    ? `arancel $${Number(carrera.arancel_anual).toLocaleString("es-CL")}`
    : null,
  carrera.empleabilidad_1er_anio
    ? `${(carrera.empleabilidad_1er_anio * 100).toFixed(0)}% de empleabilidad al 1er año`
    : null,
].filter(Boolean);

const detalle = datos.join(", ");
const description = recortarDescripcion(
  `Estudia ${nombreCarrera} en ${institucionNombre}${lugar ? `, ${lugar}` : ""}. ` +
    (detalle ? `${detalle.charAt(0).toUpperCase()}${detalle.slice(1)}. ` : "") +
    "Compara y postula con datos oficiales SIES. Admisión 2026.",
);

// Cada ficha generada YA es la canónica (los duplicados de `canonico` no
// llegan a generar página, ver getStaticPaths arriba) — el canonical es
// simplemente su propia URL.
const canonical = enlaceCarrera(carrera.slug);
const institucionUrl = carrera.instituciones?.slug
  ? enlaceInstitucion(carrera.instituciones.slug)
  : "/herramientas/instituciones";

// Otras sedes y jornadas del mismo programa: enlazado interno entre hermanas.
const variantes = await variantesDelPrograma(
  carrera.nombre_carrera,
  carrera.codigo_institucion,
  String(carrera.codigo_carrera),
);

// Hub de la carrera y de la región: dan a esta ficha un "padre" temático al
// que subir, en vez de colgar directamente de la home.
const slugCarrera = slugificar(carrera.nombre_carrera);
const regionMeta = regionPorValor(carrera.region);

const jsonLd = [
  breadcrumbSchema([
    { name: "Inicio", url: "/" },
    { name: "Carreras", url: "/carreras" },
    { name: nombreCarrera, url: `/carreras/${slugCarrera}` },
    { name: `${institucionNombre}${lugar ? ` - ${lugar}` : ""}`, url: canonical },
  ]),
  courseSchema({
    name: `${nombreCarrera}${lugar ? ` - ${lugar}` : ""}`,
    description,
    url: canonical,
    providerName: carrera.instituciones?.nombre,
    providerUrl: institucionUrl,
    arancel: carrera.arancel_anual,
    duracionSemestres: carrera.duracion_semestres,
    jornada: carrera.jornada,
    lugar,
  }),
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  type="article"
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-[#F4F5F9]">
    <CarreraDetalle carrera={carrera} client:load />

    {/* Enlazado interno renderizado en el servidor: la ficha era una hoja sin
        un solo enlace saliente, así que ni los buscadores ni los usuarios
        podían pasar de aquí a la institución o a las otras sedes. */}
    <nav
      aria-label="Programas y ficha relacionados"
      class="max-w-5xl mx-auto px-6 pb-20"
    >
      <div
        class="bg-white rounded-[2.5rem] border border-slate-100 shadow-sm p-8 md:p-10"
      >
        <h2 class="text-xl font-black text-slate-800 tracking-tight mb-2">
          Explora más sobre {nombreCarrera}
        </h2>
        <p class="text-sm text-slate-500 mb-6">
          Compara esta carrera con otras sedes y revisa la ficha de la
          institución.
        </p>

        <div class="flex flex-col gap-2">
          <a
            href={`/carreras/${slugCarrera}`}
            class="inline-flex items-center gap-2 text-sm font-bold text-[#6544FF] hover:underline"
          >
            Ver dónde más se estudia {nombreCarrera} en Chile
          </a>
          <a
            href={institucionUrl}
            class="inline-flex items-center gap-2 text-sm font-bold text-[#6544FF] hover:underline"
          >
            Ver todas las carreras de {institucionNombre}
          </a>
          {
            regionMeta && (
              <a
                href={`/carreras/region/${regionMeta.slug}`}
                class="inline-flex items-center gap-2 text-sm font-bold text-[#6544FF] hover:underline"
              >
                Ver toda la oferta de la {regionMeta.nombre}
              </a>
            )
          }
        </div>

        {
          variantes.length > 0 && (
            <div class="mt-8">
              <h3 class="text-sm font-black uppercase tracking-wider text-slate-400 mb-4">
                {nombreCarrera} en otras sedes y jornadas
              </h3>
              <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                {variantes.map((v) => {
                  const lugarV = describirLugar(v.sede, v.region);
                  const jornadaV = describirJornada(v.jornada);
                  return (
                    <li>
                      <a
                        href={enlaceCarrera(v.slug)}
                        class="flex items-center justify-between gap-3 p-3 rounded-2xl bg-slate-50 border border-slate-100 hover:border-[#6544FF]/30 hover:bg-white transition-colors"
                      >
                        <span class="text-sm font-semibold text-slate-700">
                          {lugarV || "Sede no informada"}
                          {jornadaV && (
                            <span class="text-slate-400 font-medium">
                              {" "}
                              · {jornadaV}
                            </span>
                          )}
                        </span>
                        {v.arancel_anual && (
                          <span class="text-xs font-bold text-slate-500 shrink-0">
                            ${Number(v.arancel_anual).toLocaleString("es-CL")}
                          </span>
                        )}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          )
        }

        <div class="mt-8 pt-6 border-t border-slate-100 flex flex-wrap gap-x-6 gap-y-2 text-sm">
          <a href="/herramientas/buscador" class="text-slate-600 hover:text-[#6544FF] font-semibold">
            Buscador de carreras
          </a>
          <a href="/herramientas/calculadora" class="text-slate-600 hover:text-[#6544FF] font-semibold">
            Calcular mi puntaje ponderado
          </a>
          <a href="/herramientas/mercado-laboral" class="text-slate-600 hover:text-[#6544FF] font-semibold">
            Empleabilidad por carrera
          </a>
          <a href="/herramientas/fuas" class="text-slate-600 hover:text-[#6544FF] font-semibold">
            Becas y gratuidad
          </a>
        </div>
      </div>
    </nav>
  </main>
</Layout>

<style>
  main {
    contain: content;
  }
</style>
