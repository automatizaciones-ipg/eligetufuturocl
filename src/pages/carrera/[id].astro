---
// src/pages/carrera/[id].astro
import type { GetStaticPaths } from "astro";
import { supabase } from "../../../lib/supabase";
import CarreraDetalle from "../../components/CarreraDetalle";
import Layout from "../../layouts/Layout.astro";
import { courseSchema, breadcrumbSchema } from "../../lib/seo";

export const prerender = true;

export const getStaticPaths = (async () => {
  let allCodes: any[] = [];
  let hasMore = true;
  let page = 0;
  const limit = 1000;

  while (hasMore) {
    const { data, error } = await supabase
      .from("carreras")
      .select("codigo_carrera")
      .range(page * limit, (page + 1) * limit - 1);

    if (error || !data || data.length === 0) {
      hasMore = false;
    } else {
      allCodes = [...allCodes, ...data];
      page++;
    }
  }

  return allCodes.map((carrera) => ({
    params: { id: carrera.codigo_carrera.toString() },
  }));
}) satisfies GetStaticPaths;

const { id } = Astro.params;

const { data: carrera, error } = await supabase
  .from("carreras")
  .select(
    `
    *,
    instituciones (
      nombre, 
      tipo,
      logo_url
    )
  `,
  )
  .eq("codigo_carrera", id)
  .single();

if (error || !carrera) {
  return Astro.redirect("/404");
}

const title = `${carrera.nombre_carrera} - ${carrera.instituciones?.nombre} | Elige Tu Futuro`;

const institucionNombre = carrera.instituciones?.nombre ?? "institución de educación superior";
const detalles = [
  carrera.region && `Región: ${carrera.region}`,
  carrera.jornada && `Jornada: ${carrera.jornada}`,
  carrera.duracion_semestres && `Duración: ${carrera.duracion_semestres} semestres`,
  carrera.empleabilidad_1er_anio &&
    `Empleabilidad 1er año: ${carrera.empleabilidad_1er_anio}%`,
]
  .filter(Boolean)
  .join(". ");

const description =
  carrera.descripcion?.slice(0, 200) ||
  `Estudia ${carrera.nombre_carrera} en ${institucionNombre} (Chile). ${detalles}. Conoce arancel, duración, jornada, acreditación y empleabilidad. Admisión 2026.`;

const canonical = `/carrera/${id}`;
const jsonLd = [
  breadcrumbSchema([
    { name: "Inicio", url: "/" },
    { name: "Buscador de Carreras", url: "/herramientas/buscador" },
    { name: carrera.nombre_carrera, url: canonical },
  ]),
  courseSchema({
    name: carrera.nombre_carrera,
    description,
    url: canonical,
    providerName: carrera.instituciones?.nombre,
  }),
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  type="article"
  jsonLd={jsonLd}
>
  <main class="min-h-screen bg-[#F4F5F9]">
    <CarreraDetalle carrera={carrera} client:load />
  </main>
</Layout>

<style>
  main {
    contain: content;
  }
</style>
