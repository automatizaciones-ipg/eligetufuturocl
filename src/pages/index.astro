---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.tsx";
import Hero from "../components/Hero.tsx";
import FeaturedEventBanner from "../components/FeaturedEventBanner.tsx"; // El nuevo banner responsivo estilo Figma
import CarrerasDestacadas from "../components/CarrerasDestacadas.tsx";
import NoticiasDestacadas from "../components/NoticiasDestacadas.tsx";
import ToolsSection from "../components/ToolsSection.tsx";
import { faqSchema } from "../lib/seo";

// FAQ de marca: refuerza el SEO y, sobre todo, el GEO (respuestas que los
// motores de IA pueden citar directamente).
const homeFaq = faqSchema([
  {
    question: "¿Qué es Elige Tu Futuro?",
    answer:
      "Elige Tu Futuro es una plataforma chilena gratuita de orientación vocacional con test vocacional, buscador de carreras e instituciones, calculadora de puntaje PAES, calendario de admisión, guía de becas y FUAS, y datos de empleabilidad para la Admisión 2026.",
  },
  {
    question: "¿Cómo sé qué carrera estudiar en Chile?",
    answer:
      "Puedes hacer el test vocacional gratuito basado en el modelo RIASEC, que en 5 minutos identifica tu perfil y te recomienda carreras e instituciones afines con datos oficiales del SIES.",
  },
  {
    question: "¿La plataforma tiene costo?",
    answer:
      "No. Todas las herramientas de Elige Tu Futuro (test, buscador, calculadora PAES y guía de becas) son gratuitas.",
  },
]);

// FUTURA CONEXIÓN SUPABASE / API
// Deja esta estructura fija. Cuando montes la base de datos, solo mapeas la respuesta aquí.
const featuredEvent = {
  id: "siad-2026",
  isFeatured: true,
  featuredLabel: "Evento Destacado",
  mainTitle: "SALÓN DE ORIENTACIÓN",
  subtitle: "y Alternativas Académicas",
  badgeText: "SIAD 2026",
  description: "La feria de alternativas académicas y orientación vocacional",
  buttonText: "CONOCE SIAD 2026",
  buttonUrl: "https://siad.cl/cl/",
  imageUrl: "/imagenes/Banner_Img.webp",
  imageAlt: "Estudiantes revisando orientación vocacional en su celular",
};
---

<Layout
  title="Elige Tu Futuro - Orientación Vocacional y Carreras en Chile"
  description="Plataforma gratuita de orientación vocacional en Chile: test vocacional, buscador de carreras e instituciones, calculadora PAES, becas, FUAS y empleabilidad. Admisión 2026."
  jsonLd={[homeFaq]}
>
  <main class="bg-[#F4F5F9] overflow-x-hidden">
    <Hero client:load />

    <CarrerasDestacadas client:visible />

    <FeaturedEventBanner event={featuredEvent} client:visible />

    <ToolsSection client:visible />

    <NoticiasDestacadas client:visible />
  </main>
</Layout>
