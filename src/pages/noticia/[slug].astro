---
// src/pages/noticia/[slug].astro
import Layout from "../../layouts/Layout.astro";
import NoticiaSingle from "../../components/NoticiaSingle"; // Componente React
import { supabase } from "../../../lib/supabase";
import { mapearNoticia, type Noticia, type NoticiaRow } from "../../types/noticia";
import { newsArticleSchema, breadcrumbSchema, SITE } from "../../lib/seo";

// SSR: leemos cualquier slug en tiempo real desde la URL.
export const prerender = false;

const { slug } = Astro.params;

// El artículo se resuelve ENTERO en el servidor y se le pasa al componente como
// prop. Antes se montaba con `client:only`, así que el cuerpo, el título visible
// y los encabezados no existían en el HTML: los buscadores solo veían el
// esqueleto de carga y ninguna noticia llegaba a indexarse.
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

let noticia: Noticia | null = null;

if (slug) {
  try {
    const { data } = await supabase
      .from("noticias")
      .select("*")
      .eq("slug", slug)
      .eq("estado", "activado") // Solo artículos publicados
      .single();
    if (data) noticia = mapearNoticia(data as NoticiaRow);
  } catch {
    // Si Supabase falla, se responde como "no disponible" en vez de romper.
  }
}

// Compatibilidad con las URLs UUID viejas (antes de agregar `slug`): si el
// segmento es un UUID que resuelve a una noticia, redirige 301 a su URL
// canónica con nombre en vez de devolver 404. A diferencia del incidente de
// ago 2026 (un redirect en el middleware horneó miles de páginas como stub
// durante el BUILD), este redirect corre en una página `prerender: false` —
// solo afecta al request puntual, no al build.
if (!noticia && slug && UUID_RE.test(slug)) {
  try {
    const { data } = await supabase
      .from("noticias")
      .select("slug")
      .eq("id", slug)
      .eq("estado", "activado")
      .single();
    if (data?.slug) return Astro.redirect(`/noticia/${data.slug}`, 301);
  } catch {
    // Si falla, cae al 404 normal de abajo.
  }
}

// Un artículo inexistente o despublicado debe devolver 404 de verdad: antes
// respondía 200 con un cartel de error, lo que deja URLs muertas indexables.
if (!noticia) {
  Astro.response.status = 404;
}

// Seo.astro ya agrega " | {SITE.name}" si el título no lo incluye —sumar acá
// un sufijo de marca distinto duplicaba el <title> en producción.
const titulo = noticia ? noticia.titulo : "Artículo no disponible";
const description = noticia
  ? (noticia.extracto || SITE.description).slice(0, 200)
  : "El artículo que buscas no está disponible. Explora las guías de orientación vocacional de Elige Tu Futuro.";
const image = noticia?.imagenPrincipal || SITE.defaultOgImage;
const canonical = `/noticia/${slug}`;
const publishedTime = noticia?.createdAt
  ? new Date(noticia.createdAt).toISOString()
  : undefined;

const jsonLd = noticia
  ? [
      breadcrumbSchema([
        { name: "Inicio", url: "/" },
        { name: "Noticias", url: "/noticias" },
        { name: noticia.titulo, url: canonical },
      ]),
      newsArticleSchema({
        headline: noticia.titulo,
        description,
        url: canonical,
        image,
        datePublished: publishedTime,
        author: noticia.autor,
        // El cuerpo completo en el JSON-LD ayuda a que buscadores y motores de
        // IA citen el artículo aunque no ejecuten JavaScript.
        articleBody: noticia.cuerpoMarkdown,
        section: noticia.categoria,
        keywords: noticia.tags,
        // Le dice al motor de IA exactamente qué bloque leer/citar directo.
        speakableSelector: noticia.puntosClave.length ? ".resumen-rapido" : undefined,
      }),
    ]
  : [];
---

<Layout
  title={titulo}
  description={description}
  image={image}
  canonical={canonical}
  type="article"
  noindex={!noticia}
  jsonLd={jsonLd}
  article={{
    publishedTime,
    author: noticia?.autor || "Elige Tu Futuro",
    section: noticia?.categoria || "Orientación",
    tags: noticia?.tags,
  }}
>
  {
    noticia ? (
      <NoticiaSingle
        slug={slug as string}
        noticiaInicial={noticia}
        client:load
      />
    ) : (
      <main class="w-full min-h-screen bg-[#F4F5F9] flex flex-col items-center justify-center px-4">
        <div class="bg-white p-10 rounded-[2.5rem] shadow-xl text-center max-w-md border border-slate-100">
          <h1 class="font-black text-2xl text-slate-800 mb-2">
            Artículo no disponible
          </h1>
          <p class="text-slate-500 text-sm font-medium mb-6">
            El contenido solicitado no existe o ya no está publicado.
          </p>
          <a
            href="/noticias"
            class="px-6 py-3 bg-[#1A1528] text-white rounded-xl font-bold transition-transform hover:scale-105 inline-block"
          >
            Volver a Noticias
          </a>
        </div>
      </main>
    )
  }
</Layout>
