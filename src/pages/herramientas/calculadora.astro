---
// src/pages/herramientas/calculadora.astro
export const prerender = true;

import Layout from "../../layouts/Layout.astro";
import CalculadoraNem from "../../components/CalculadoraNem.tsx";
---

<Layout
  title="Simulador de Admisión: Calculadora NEM, PAES y Puntaje Ponderado por Carrera - Elige Tu Futuro"
  description="Calcula tu NEM, Ranking y puntajes PAES, y descubre tu puntaje ponderado real en miles de carreras chilenas usando la fórmula oficial de cada una (SIES). Compara hasta 3 carreras. Gratis, Admisión 2026."
>
  <div class="bg-[#fafafa] min-h-screen h-screen">
    <div class="relative z-10 w-full">
      <CalculadoraNem client:visible />
    </div>
  </div>
</Layout>
