---
import Layout from "../../layouts/Layout.astro";
import GuiaFuas from "../../components/GuiaFuas.tsx";
import { faqSchema, breadcrumbSchema } from "../../lib/seo";

const PREGUNTAS_FRECUENTES = [
  {
    question: "¿Qué es el FUAS?",
    answer:
      "El FUAS (Formulario Único de Acreditación Socioeconómica) es el formulario gratuito que se completa en línea para postular a la gratuidad, becas de arancel y créditos del Estado en Chile.",
  },
  {
    question: "¿Cuándo se llena el FUAS para la Admisión 2026?",
    answer:
      "El FUAS se completa durante el periodo oficial definido por el MINEDUC, generalmente entre octubre y noviembre del año anterior al ingreso. Conviene completarlo apenas se abre la plataforma.",
  },
  {
    question: "¿Quiénes pueden acceder a la gratuidad?",
    answer:
      "La gratuidad está dirigida a estudiantes pertenecientes a los hogares de menores ingresos del país que estudien en instituciones adscritas al beneficio, cumpliendo los requisitos académicos y socioeconómicos.",
  },
];

const fuasJsonLd = [
  breadcrumbSchema([
    { name: "Inicio", url: "/" },
    { name: "Becas y Gratuidad (FUAS)", url: "/herramientas/fuas" },
  ]),
  faqSchema(PREGUNTAS_FRECUENTES),
];
---

<Layout
  title="Guía FUAS y Gratuidad - Beneficios Estudiantiles"
  description="Guía completa para postular a la gratuidad, becas y créditos en Chile: cómo y cuándo completar el FUAS, requisitos y beneficios estudiantiles para la Admisión 2026."
  jsonLd={fuasJsonLd}
>
  <div class="bg-[#FAFAFA] min-h-screen">
    <div class="">
      <GuiaFuas client:load />
    </div>

    <section aria-labelledby="faq-fuas" class="max-w-3xl mx-auto px-4 py-16">
      <h2 id="faq-fuas" class="text-2xl md:text-3xl font-black text-[#1A1528] tracking-tight text-center">
        Preguntas frecuentes
      </h2>
      <div class="mt-8 space-y-3">
        {
          PREGUNTAS_FRECUENTES.map((p) => (
            <details class="bg-white rounded-2xl border border-gray-100 p-5 group">
              <summary class="font-bold text-[#1A1528] cursor-pointer list-none flex justify-between items-center gap-4">
                {p.question}
                <span class="text-[#6544FF] text-xl group-open:rotate-45 transition-transform">
                  +
                </span>
              </summary>
              <p class="mt-3 text-[#1A1528]/70 leading-relaxed">{p.answer}</p>
            </details>
          ))
        }
      </div>
    </section>
  </div>
</Layout>
