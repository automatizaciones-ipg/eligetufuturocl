---
// src/pages/carreras/index.astro
// ============================================================================
// Índice de todas las páginas hub. Es la raíz del árbol de enlaces que faltaba:
// desde aquí se llega a cada carrera y a cada región, y desde ahí a las ~9.900
// fichas. Sin esta página, los hubs quedarían tan huérfanos como las fichas.
// ============================================================================
import Layout from "../../layouts/Layout.astro";
import { breadcrumbSchema, faqSchema } from "../../lib/seo";
import { formatearTitulo, recortarDescripcion } from "../../utils/formatters";
import { REGIONES } from "../../utils/regiones";
import { indiceCarreras, calcularEstadisticas } from "../../services/carrerasIndex";

export const prerender = true;

const { porNombre, nombrePorSlug, porRegion } = await indiceCarreras();

const carreras = [...porNombre.entries()]
  .map(([slug, filas]) => ({
    slug,
    nombre: formatearTitulo(nombrePorSlug.get(slug) ?? ""),
    programas: filas.length,
    instituciones: new Set(filas.map((f) => String(f.codigo_institucion))).size,
  }))
  .filter((c) => c.nombre)
  .sort((a, b) => a.nombre.localeCompare(b.nombre, "es"));

// Agrupación alfabética: una lista plana de 1.500 enlaces no se navega.
const porLetra = new Map<string, typeof carreras>();
for (const c of carreras) {
  const letra = c.nombre
    .charAt(0)
    .toUpperCase()
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "");
  const inicial = /[A-Z]/.test(letra) ? letra : "#";
  const lista = porLetra.get(inicial);
  if (lista) lista.push(c);
  else porLetra.set(inicial, [c]);
}
const letras = [...porLetra.keys()].sort();

const totalProgramas = [...porNombre.values()].reduce((s, f) => s + f.length, 0);
const totalInstituciones = calcularEstadisticas(
  [...porNombre.values()].flat(),
).instituciones;

// Las 12 carreras con más oferta: atajo útil arriba y refuerzo de enlazado.
const masOfertadas = [...carreras].sort((a, b) => b.programas - a.programas).slice(0, 12);

const regionesConDatos = REGIONES.map((r) => ({
  ...r,
  programas: porRegion.get(r.valor)?.length ?? 0,
})).filter((r) => r.programas > 0);

const description = recortarDescripcion(
  `Directorio de las ${carreras.length} carreras que se imparten en Chile: ${totalProgramas} programas en ${totalInstituciones} instituciones. Compara aranceles, duración y empleabilidad con datos oficiales SIES.`,
);

const preguntas = [
  {
    question: "¿Cuántas carreras se pueden estudiar en Chile?",
    answer: `La oferta de educación superior chilena para la Admisión 2026 reúne ${carreras.length} carreras distintas, con ${totalProgramas} programas impartidos por ${totalInstituciones} instituciones entre universidades, institutos profesionales y centros de formación técnica, según el SIES (MINEDUC).`,
  },
  {
    question: "¿Cómo elijo qué carrera estudiar?",
    answer:
      "Cruza tres cosas: tus intereses (el test vocacional gratuito basado en el modelo RIASEC los identifica en 5 minutos), los datos objetivos de cada carrera (arancel, duración, empleabilidad e ingresos) y tu puntaje proyectado en la PAES. En cada página de carrera encuentras los datos oficiales para hacer esa comparación.",
  },
  {
    question: "¿Dónde veo el arancel y la empleabilidad de una carrera?",
    answer:
      "Cada página de carrera muestra el rango de aranceles anuales, la duración típica en semestres, la empleabilidad al primer año y el ingreso promedio al cuarto año, con la fuente oficial del Servicio de Información de Educación Superior (SIES) del MINEDUC.",
  },
];

const jsonLd = [
  breadcrumbSchema([
    { name: "Inicio", url: "/" },
    { name: "Carreras", url: "/carreras" },
  ]),
  faqSchema(preguntas),
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: "Todas las carreras de Chile",
    description,
    url: `/carreras`,
  },
];
---

<Layout
  title="Todas las Carreras de Chile: Aranceles, Duración y Empleabilidad"
  description={description}
  canonical="/carreras"
  jsonLd={jsonLd}
>
  <main class="bg-[#F4F5F9] min-h-screen pb-20">
    <header class="bg-[#1A1528] text-white">
      <div class="max-w-6xl mx-auto px-6 pt-28 pb-16">
        <nav aria-label="Migas de pan" class="text-sm text-white/50 mb-6">
          <a href="/" class="hover:text-white">Inicio</a>
          <span class="mx-2">/</span>
          <span class="text-white/80">Carreras</span>
        </nav>

        <h1 class="font-black italic uppercase text-4xl md:text-6xl tracking-tight leading-[1.05]">
          Todas las <span
            class="text-transparent bg-clip-text bg-gradient-to-r from-[#8B5CF6] via-[#D946EF] to-[#3B82F6]"
            >carreras</span
          > de Chile
        </h1>

        <p class="mt-6 text-lg text-white/70 max-w-3xl leading-relaxed">
          {carreras.length} carreras distintas, {totalProgramas} programas y {
            totalInstituciones
          } instituciones de educación superior. Entra a cualquiera para ver dónde
          se imparte, cuánto cuesta, cuánto dura y qué empleabilidad tiene, con
          datos oficiales del SIES para la Admisión 2026.
        </p>
      </div>
    </header>

    <div class="max-w-6xl mx-auto px-6 -mt-10">
      <section class="bg-white rounded-[2rem] border border-slate-100 shadow-sm p-8">
        <h2 class="text-xl font-black text-[#1A1528] tracking-tight mb-4">
          Las carreras con más oferta
        </h2>
        <ul class="flex flex-wrap gap-2">
          {
            masOfertadas.map((c) => (
              <li>
                <a
                  href={`/carreras/${c.slug}`}
                  class="inline-flex items-center gap-2 rounded-xl bg-slate-50 border border-slate-100 px-4 py-2 text-sm font-semibold text-slate-700 hover:border-[#6544FF]/40 hover:text-[#6544FF] transition-colors"
                >
                  {c.nombre}
                  <span class="text-xs text-slate-400">{c.programas}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-10">
        <h2 class="text-2xl md:text-3xl font-black text-[#1A1528] tracking-tight">
          Carreras por región
        </h2>
        <ul class="mt-6 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
          {
            regionesConDatos.map((r) => (
              <li>
                <a
                  href={`/carreras/region/${r.slug}`}
                  class="block bg-white rounded-2xl border border-slate-100 p-4 hover:border-[#6544FF]/40 hover:shadow-md transition-all"
                >
                  <p class="font-bold text-[#1A1528] text-sm leading-snug">
                    {r.nombre.replace(/^Región (de |del |)/, "")}
                  </p>
                  <p class="mt-1 text-xs text-slate-400">
                    {r.programas} programas · {r.capital}
                  </p>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="mt-12">
        <h2 class="text-2xl md:text-3xl font-black text-[#1A1528] tracking-tight">
          Directorio alfabético
        </h2>

        <nav aria-label="Saltar a una letra" class="mt-4 flex flex-wrap gap-1.5">
          {
            letras.map((l) => (
              <a
                href={`#letra-${l}`}
                class="w-9 h-9 flex items-center justify-center rounded-lg bg-white border border-slate-100 text-sm font-black text-slate-600 hover:border-[#6544FF]/40 hover:text-[#6544FF] transition-colors"
              >
                {l}
              </a>
            ))
          }
        </nav>

        {
          letras.map((l) => (
            <div id={`letra-${l}`} class="mt-8 scroll-mt-24">
              <h3 class="text-lg font-black text-[#6544FF] tracking-tight mb-3">{l}</h3>
              <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-6 gap-y-1">
                {porLetra.get(l)!.map((c) => (
                  <li>
                    <a
                      href={`/carreras/${c.slug}`}
                      class="flex items-baseline justify-between gap-3 py-2 border-b border-slate-200/70 text-sm text-slate-700 hover:text-[#6544FF] transition-colors"
                    >
                      <span class="font-medium">{c.nombre}</span>
                      <span class="text-xs text-slate-400 shrink-0">
                        {c.instituciones}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      <section class="mt-12">
        <h2 class="text-2xl md:text-3xl font-black text-[#1A1528] tracking-tight">
          Preguntas frecuentes
        </h2>
        <div class="mt-6 space-y-3">
          {
            preguntas.map((p) => (
              <details class="bg-white rounded-2xl border border-slate-100 p-5 group">
                <summary class="font-bold text-[#1A1528] cursor-pointer list-none flex justify-between items-center gap-4">
                  {p.question}
                  <span class="text-[#6544FF] text-xl group-open:rotate-45 transition-transform">
                    +
                  </span>
                </summary>
                <p class="mt-3 text-slate-600 leading-relaxed">{p.answer}</p>
              </details>
            ))
          }
        </div>
      </section>
    </div>
  </main>
</Layout>
