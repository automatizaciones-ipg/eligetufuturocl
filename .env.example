# ─── Supabase ───────────────────────────────────────────────
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
# Recomendado en producción (evita bloqueos RLS en APIs):
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ─── Resend (correos transaccionales) ───────────────────────
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente verificado en Resend (debe ser de tu dominio):
# Ejemplo: "EligeTuFuturo <contacto@eligetufuturo.cl>"
RESEND_FROM_EMAIL=EligeTuFuturo <contacto@eligetufuturo.cl>

# Correo interno donde llegan los leads y contactos:
RESEND_TO_EMAIL=contacto@eligetufuturo.cl

# ─── Sitio ──────────────────────────────────────────────────
PUBLIC_SITE_URL=https://eligetufuturo.cl

# ─── Analítica y mapas de calor (opcional) ──────────────────
# Google Analytics 4 — crea una propiedad en https://analytics.google.com
# y pega el ID de medición (formato G-XXXXXXXXXX):
PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity — mapas de calor + grabaciones de sesión (gratis e
# ilimitado). Crea un proyecto en https://clarity.microsoft.com y pega el ID:
PUBLIC_CLARITY_PROJECT_ID=

# ─── Marketing (opcional, protege /api/marketing/enviar) ───
MARKETING_API_SECRET=tu_secreto_largo_y_aleatorio

# ─── Panel admin oculto de tendencias (/admin/tendencias) ───
# Contraseña única del operador (sin usuarios/roles).
ADMIN_PASSWORD=cambia_esto_por_una_clave_larga
# Firma la cookie de sesión. Genera con: openssl rand -hex 32
ADMIN_SESSION_SECRET=genera_un_secreto_aleatorio_largo

# ─── Leads → Webhook n8n → Bitrix24 + Google Sheets ─────────
# Cada lead (test vocacional, contacto, solicitudes de info) se notifica a un
# Webhook de n8n, que centraliza la escritura en Google Sheets y en Bitrix24.
# Las credenciales de Sheets/Bitrix viven SOLO dentro de n8n, nunca aquí. Ver
# sección "Leads → n8n → Bitrix24 + Google Sheets" en CLAUDE.md.
# URL de PRODUCCIÓN del Webhook de n8n (no la URL de "test" del editor):
N8N_LEADS_WEBHOOK_URL=
# Secreto compartido para el header "Authorization: Bearer <valor>", validado
# por la credencial "Header Auth" del nodo Webhook en n8n. Genera con:
#   openssl rand -hex 32
N8N_LEADS_WEBHOOK_SECRET=

# ─── Firecrawl (scraping/enriquecimiento de instituciones) ──
# Solo para los scripts ETL de src/datos_et/. Crea tu key en:
# https://www.firecrawl.dev → API Keys (formato fc-xxxxxxxx)
FIRECRAWL_API_KEY=

# ─── Notas para los scripts ETL (src/datos_et/) ─────────────
# Los scripts de Python (geocodificar / enriquecer) leen las credenciales de
# Supabase de forma flexible: aceptan SUPABASE_URL/SUPABASE_KEY y, si no
# existen, usan las variables que ya tienes arriba (PUBLIC_SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY). No necesitas duplicar nada.

# ─── Cron semanal de noticias IA (/api/cron/noticias) ───────
# Redacta y publica automáticamente un artículo de tips para estudiantes cada
# viernes 16:00 (hora Chile), disparado por .github/workflows/cron-noticias.yml.
# API key de Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Access Key de la Unsplash API (búsqueda de fotos) — crea una app developer en
# https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=
# Secreto compartido que autentica el POST del workflow de GitHub Actions
# (header "Authorization: Bearer <valor>"). Genera con: openssl rand -hex 32
NOTICIAS_CRON_SECRET=
