# ─── Supabase ───────────────────────────────────────────────
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu_anon_key
# Recomendado en producción (evita bloqueos RLS en APIs):
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# ─── Resend (correos transaccionales) ───────────────────────
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Remitente verificado en Resend (debe ser de tu dominio):
# Ejemplo: "EligeTuFuturo <contacto@eligetufuturo.cl>"
RESEND_FROM_EMAIL=EligeTuFuturo <contacto@eligetufuturo.cl>

# Correo interno donde llegan los leads y contactos:
RESEND_TO_EMAIL=contacto@eligetufuturo.cl

# ─── Sitio ──────────────────────────────────────────────────
PUBLIC_SITE_URL=https://eligetufuturo.cl

# ─── Analítica y mapas de calor (opcional) ──────────────────
# Google Analytics 4 — crea una propiedad en https://analytics.google.com
# y pega el ID de medición (formato G-XXXXXXXXXX):
PUBLIC_GA_MEASUREMENT_ID=

# Microsoft Clarity — mapas de calor + grabaciones de sesión (gratis e
# ilimitado). Crea un proyecto en https://clarity.microsoft.com y pega el ID:
PUBLIC_CLARITY_PROJECT_ID=

# ─── Marketing (opcional, protege /api/marketing/enviar) ───
MARKETING_API_SECRET=tu_secreto_largo_y_aleatorio

# ─── Firecrawl (scraping/enriquecimiento de instituciones) ──
# Solo para los scripts ETL de src/datos_et/. Crea tu key en:
# https://www.firecrawl.dev → API Keys (formato fc-xxxxxxxx)
FIRECRAWL_API_KEY=

# ─── Notas para los scripts ETL (src/datos_et/) ─────────────
# Los scripts de Python (geocodificar / enriquecer) leen las credenciales de
# Supabase de forma flexible: aceptan SUPABASE_URL/SUPABASE_KEY y, si no
# existen, usan las variables que ya tienes arriba (PUBLIC_SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY). No necesitas duplicar nada.
